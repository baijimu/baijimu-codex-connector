{
  "schemaVersion": "2.0",
  "id": "com.baijimu.connector.codex-connector",
  "name": "Codex 远程连接器",
  "version": "2.0.0",
  "description": "安装并托管 Codex CLI，通过平台授权访问设备系统默认 Codex 的会话、线程、轮次和事件。",
  "icon": {
    "mediaType": "image/png",
    "data": ""
  },
  "publisher": {
    "name": "Baijimu",
    "homepage": "https://baijimu.com"
  },
  "source": {
    "type": "github",
    "repo": "baijimu/baijimu-codex-connector",
    "revision": "v2.0.0"
  },
  "runtime": {
    "type": "process",
    "command": "baijimu-connector-codex",
    "args": [
      "start"
    ],
    "stopArgs": [
      "stop"
    ],
    "processOwnership": "host",
    "healthCheck": {
      "type": "http",
      "url": "http://127.0.0.1:18111/healthz",
      "timeoutSecs": 2,
      "expectStatus": 200
    }
  },
  "management": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18111",
    "auth": {
      "type": "connector_token"
    },
    "operations": {
      "setupState": {
        "method": "GET",
        "path": "/management/v1/setup/state"
      },
      "setupRetry": {
        "method": "POST",
        "path": "/management/v1/setup/retry"
      },
      "ensureCodexReady": {
        "method": "POST",
        "path": "/management/v1/setup/ensure-ready"
      },
      "checkoutPlatformProject": {
        "method": "POST",
        "path": "/management/v1/projects/checkout"
      }
    }
  },
  "hostRequirements": {
    "minimumVersion": "0.3.0",
    "capabilities": [
      "connector.process.host-managed.v1",
      "connector.managed-tool-dependencies.v1",
      "connector.presentation.icon.v1"
    ]
  },
  "managedToolDependencies": [
    {
      "id": "com.baijimu.cli",
      "minimumVersion": "0.1.50",
      "requiredFor": [
        "install",
        "start"
      ],
      "executablePathEnv": "CODEX_CONNECTOR_BAIJIMU_BINARY"
    }
  ],
  "releaseNotes": [
    "平台工作区仅作为设备调用授权上下文，不再创建或选择 Codex 工作区档案。",
    "所有远程能力统一使用设备用户的系统默认 .codex 和单一 Connector app-server。",
    "移除 listWorkspaceProfiles 方法以及按平台工作区隔离 CODEX_HOME、凭证和进程的行为。"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "port": {
        "type": "integer",
        "default": 18111,
        "minimum": 1024,
        "maximum": 65535
      },
      "listen": {
        "type": "string",
        "default": "stdio://"
      },
      "projectsDirectory": {
        "type": "string",
        "description": "用于标准平台项目检出的绝对目录。"
      }
    },
    "additionalProperties": false
  },
  "remoteCapabilities": [
    {
      "name": "codex.project.read",
      "risk": "medium",
      "description": "从设备系统默认 Codex 状态、项目配置和任务元数据中读取项目根目录。"
    },
    {
      "name": "codex.thread.read",
      "risk": "medium",
      "description": "读取、列出和搜索本地 Codex 任务元数据及流式输出。"
    },
    {
      "name": "codex.thread.read-state.write",
      "risk": "medium",
      "description": "将一个本地 Codex 任务标记为已读或未读，供连接器管理会话。"
    },
    {
      "name": "codex.app.read",
      "risk": "medium",
      "description": "列出本地 Codex 账号可见的 app-server 应用和连接器。"
    },
    {
      "name": "codex.turn.write",
      "risk": "medium",
      "description": "向本地 Codex 发送提示词和引导指令。"
    },
    {
      "name": "codex.raw.request",
      "risk": "high",
      "description": "向本地 Codex app-server 转发高级 JSON-RPC 请求。"
    },
    {
      "name": "codex.turn.interrupt",
      "risk": "medium",
      "description": "中断正在执行的 Codex 轮次。"
    }
  ],
  "transport": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18111"
  },
  "methods": [
    {
      "name": "status",
      "description": "返回连接器和 Codex app-server 的连接状态。",
      "path": "/invoke/status",
      "httpMethod": "POST",
      "timeoutSecs": 5,
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "listThreads",
      "description": "分页列出本地 Codex 任务及其项目元数据、运行时/轮次状态和未读状态。",
      "path": "/invoke/listThreads",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "modelProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "vscode",
                "exec",
                "appServer",
                "subAgent",
                "subAgentReview",
                "subAgentCompact",
                "subAgentThreadSpawn",
                "subAgentOther",
                "unknown"
              ]
            }
          },
          "archived": {
            "type": "boolean"
          },
          "cwd": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "useStateDbOnly": {
            "type": "boolean"
          },
          "searchTerm": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listProjects",
      "description": "根据设备系统默认 Codex 状态、项目配置和任务元数据列出项目。",
      "path": "/invoke/listProjects",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "searchTerm": {
            "type": "string"
          },
          "existsOnly": {
            "type": "boolean"
          },
          "includeSaved": {
            "type": "boolean"
          },
          "includeTrusted": {
            "type": "boolean"
          },
          "includeThreadStats": {
            "type": "boolean"
          },
          "threadCursor": {
            "type": "string"
          },
          "threadPageLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxThreadPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "archived": {
            "type": "boolean"
          },
          "useStateDbOnly": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listSessions",
      "description": "分页列出本地 Codex 会话及其项目元数据、运行时/轮次状态和未读状态。",
      "path": "/invoke/listSessions",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "modelProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "vscode",
                "exec",
                "appServer",
                "subAgent",
                "subAgentReview",
                "subAgentCompact",
                "subAgentThreadSpawn",
                "subAgentOther",
                "unknown"
              ]
            }
          },
          "archived": {
            "type": "boolean"
          },
          "cwd": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "useStateDbOnly": {
            "type": "boolean"
          },
          "searchTerm": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "searchThreads",
      "description": "按文本搜索本地 Codex 任务并返回匹配的任务元数据。",
      "path": "/invoke/searchThreads",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "searchTerm"
        ],
        "properties": {
          "searchTerm": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "vscode",
                "exec",
                "appServer",
                "subAgent",
                "subAgentReview",
                "subAgentCompact",
                "subAgentThreadSpawn",
                "subAgentOther",
                "unknown"
              ]
            }
          },
          "archived": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "readThread",
      "description": "按 ID 读取一个本地 Codex 任务，可选择包含轮次和条目。",
      "path": "/invoke/readThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "includeTurns": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "setThreadReadState",
      "description": "将一个本地 Codex 任务标记为已读或未读，并持久化已观察到的任务版本。",
      "path": "/invoke/setThreadReadState",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId",
          "hasUnreadTurn"
        ],
        "properties": {
          "threadId": {
            "type": "string",
            "minLength": 1
          },
          "hasUnreadTurn": {
            "type": "boolean"
          },
          "observedUpdatedAt": {
            "type": [
              "number",
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listThreadTurns",
      "description": "分页列出 Codex 任务轮次，可选择包含完整条目历史。",
      "path": "/invoke/listThreadTurns",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "itemsView": {
            "type": "string",
            "enum": [
              "notLoaded",
              "summary",
              "full"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listApps",
      "description": "列出本地 Codex 账号可见的 app-server 应用和连接器。",
      "path": "/invoke/listApps",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "threadId": {
            "type": "string"
          },
          "forceRefetch": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "startThread",
      "description": "通过本地 Codex app-server 新建 Codex 任务。",
      "path": "/invoke/startThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "resumeThread",
      "description": "恢复一个已有的 Codex 任务。",
      "path": "/invoke/resumeThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "excludeTurns": {
            "type": "boolean"
          },
          "initialTurnsPage": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "sortDirection": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              },
              "itemsView": {
                "type": "string",
                "enum": [
                  "notLoaded",
                  "summary",
                  "full"
                ]
              }
            },
            "additionalProperties": false
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "startTurn",
      "description": "在任务中启动一个 Codex 轮次。",
      "path": "/invoke/startTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId",
          "input"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "input": {},
          "model": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "steerTurn",
      "description": "向正在执行的 Codex 轮次追加引导输入。",
      "path": "/invoke/steerTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "input"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "input": {},
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "interruptTurn",
      "description": "中断正在执行的 Codex 轮次。",
      "path": "/invoke/interruptTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "recentEvents",
      "description": "读取连接器缓存的近期 Codex app-server 通知。",
      "path": "/invoke/recentEvents",
      "httpMethod": "POST",
      "timeoutSecs": 5,
      "input_schema": {
        "type": "object",
        "properties": {
          "afterSequence": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "request",
      "description": "向本地 Codex app-server 转发原始 JSON-RPC 请求。",
      "path": "/invoke/request",
      "httpMethod": "POST",
      "timeoutSecs": 60,
      "input_schema": {
        "type": "object",
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "events": [
    {
      "name": "codexNotification",
      "description": "本地 Codex app-server 发出的通知。",
      "enabled": true,
      "payload_schema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "codexTurnCompleted",
      "description": "Codex 轮次完成、中断或失败时发出的稳定领域事件。",
      "enabled": true,
      "payload_schema": {
        "type": "object",
        "required": [
          "schemaVersion",
          "threadId",
          "turnId",
          "status",
          "completedAt",
          "durationMs",
          "error",
          "occurredAt",
          "source",
          "sourceMethod",
          "connectorVersion"
        ],
        "properties": {
          "schemaVersion": {
            "type": "integer",
            "enum": [1]
          },
          "threadId": {
            "type": "string",
            "minLength": 1
          },
          "turnId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["completed", "interrupted", "failed"]
          },
          "completedAt": {
            "type": ["integer", "null"]
          },
          "durationMs": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "error": {
            "type": ["object", "null"],
            "additionalProperties": true
          },
          "occurredAt": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["codex-app-server"]
          },
          "sourceMethod": {
            "type": "string",
            "enum": ["turn/completed"]
          },
          "connectorVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "codexThreadClosed",
      "description": "Codex 卸载并关闭任务时发出的稳定领域事件。",
      "enabled": true,
      "payload_schema": {
        "type": "object",
        "required": ["schemaVersion", "threadId", "occurredAt", "source", "sourceMethod", "connectorVersion"],
        "properties": {
          "schemaVersion": {"type": "integer", "enum": [1]},
          "threadId": {"type": "string", "minLength": 1},
          "occurredAt": {"type": "string", "minLength": 1},
          "source": {"type": "string", "enum": ["codex-app-server"]},
          "sourceMethod": {"type": "string", "enum": ["thread/closed"]},
          "connectorVersion": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "codexThreadArchived",
      "description": "Codex 任务归档时发出的稳定领域事件。",
      "enabled": true,
      "payload_schema": {
        "type": "object",
        "required": ["schemaVersion", "threadId", "occurredAt", "source", "sourceMethod", "connectorVersion"],
        "properties": {
          "schemaVersion": {"type": "integer", "enum": [1]},
          "threadId": {"type": "string", "minLength": 1},
          "occurredAt": {"type": "string", "minLength": 1},
          "source": {"type": "string", "enum": ["codex-app-server"]},
          "sourceMethod": {"type": "string", "enum": ["thread/archived"]},
          "connectorVersion": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "codexThreadDeleted",
      "description": "Codex 任务删除时发出的稳定领域事件。",
      "enabled": true,
      "payload_schema": {
        "type": "object",
        "required": ["schemaVersion", "threadId", "occurredAt", "source", "sourceMethod", "connectorVersion"],
        "properties": {
          "schemaVersion": {"type": "integer", "enum": [1]},
          "threadId": {"type": "string", "minLength": 1},
          "occurredAt": {"type": "string", "minLength": 1},
          "source": {"type": "string", "enum": ["codex-app-server"]},
          "sourceMethod": {"type": "string", "enum": ["thread/deleted"]},
          "connectorVersion": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  ]
}
