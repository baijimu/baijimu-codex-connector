{
  "schemaVersion": "2.0",
  "id": "com.baijimu.connector.codex",
  "name": "Codex",
  "version": "1.2.47",
  "description": "Initialize and configure Codex, select an isolated Baijimu workspace or the original Codex environment, and launch Codex with the selected state directory.",
  "publisher": {
    "name": "Baijimu",
    "homepage": "https://baijimu.com"
  },
  "source": {
    "type": "github",
    "repo": "momoplan/baijimu-connector-codex",
    "revision": "v1.2.47"
  },
  "runtime": {
    "type": "process",
    "command": "baijimu-connector-codex",
    "args": [
      "start"
    ],
    "stopArgs": [
      "stop"
    ],
    "processOwnership": "host",
    "healthCheck": {
      "type": "http",
      "url": "http://127.0.0.1:18110/healthz",
      "timeoutSecs": 2,
      "expectStatus": 200
    }
  },
  "management": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18110",
    "auth": {
      "type": "connector_token"
    },
    "operations": {
      "setupState": {
        "method": "GET",
        "path": "/management/v1/setup/state"
      },
      "setupRetry": {
        "method": "POST",
        "path": "/management/v1/setup/retry"
      },
      "ensureCodexReady": {
        "method": "POST",
        "path": "/management/v1/setup/ensure-ready"
      },
      "credentialState": {
        "method": "GET",
        "path": "/management/v1/credential-state"
      },
      "launchCodex": {
        "method": "POST",
        "path": "/management/v1/codex/launch"
      },
      "restoreExternalCodexHome": {
        "method": "POST",
        "path": "/management/v1/codex/restore-external-home"
      },
      "checkoutPlatformProject": {
        "method": "POST",
        "path": "/management/v1/projects/checkout"
      },
      "listCodexProjects": {
        "method": "POST",
        "path": "/management/v1/codex/projects"
      },
      "listCodexSessions": {
        "method": "POST",
        "path": "/management/v1/codex/sessions"
      },
      "readCodexSession": {
        "method": "POST",
        "path": "/management/v1/codex/sessions/read"
      },
      "setCodexThreadReadState": {
        "method": "POST",
        "path": "/management/v1/codex/sessions/read-state"
      },
      "startCodexSession": {
        "method": "POST",
        "path": "/management/v1/codex/sessions/start"
      },
      "listCodexTurns": {
        "method": "POST",
        "path": "/management/v1/codex/turns"
      },
      "startCodexTurn": {
        "method": "POST",
        "path": "/management/v1/codex/turns/start"
      },
      "interruptCodexTurn": {
        "method": "POST",
        "path": "/management/v1/codex/turns/interrupt"
      },
      "recentCodexEvents": {
        "method": "POST",
        "path": "/management/v1/codex/events"
      }
    }
  },
  "hostRequirements": {
    "minimumVersion": "0.2.82",
    "capabilities": [
      "connector.process.host-managed.v1",
      "connector.managed-tool-dependencies.v1"
    ]
  },
  "managedToolDependencies": [
    {
      "id": "com.baijimu.cli",
      "minimumVersion": "0.1.43",
      "requiredFor": [
        "install",
        "start"
      ],
      "executablePathEnv": "CODEX_CONNECTOR_BAIJIMU_BINARY"
    }
  ],
  "ui": {
    "type": "embedded",
    "entry": "ui/index.html",
    "title": "Codex 工作区管理",
    "defaultView": true
  },
  "releaseNotes": [
    "声明 Baijimu CLI 为安装与启动阶段的官方托管工具依赖；Bridge Agent 会等待 CLI 完成安装或修复并在每次启动时注入已验证的稳定 launcher 绝对路径，不再依赖首次安装进程继承的 PATH。",
    "初始化完成前使用独立安装视图，只显示安装进度、失败原因和修复入口；初始化成功后才切换到 Codex 环境状态与工作区管理，避免安装过程中提前暴露不可用操作。",
    "百积木平台认证和 Partner API 调用统一交由平台管理的 baijimu CLI；Connector 不再读取共享 PAT 文件，也不再自行发起工作区或 LLM credential HTTP 请求。",
    "工作区初始化与修复通过 baijimu llm-credential create 重新签发 LLM credential，并对 CLI 的认证状态、工作区和凭证响应使用类型化契约校验。",
    "从旧版长路径升级时，Connector 会在启动就绪前检测活动档案迁移，先停止占用目录的 Codex 桌面进程，完成原子迁移后再以短 CODEX_HOME 恢复桌面，避免 Windows 文件占用导致迁移卡在可恢复中间态。",
    "百积木工作区 Codex Home 统一放入用户目录下的 .baijimu/codex/p/<短档案键>，不再把环境、用户、客户端和工作区标识逐层拼入物理路径，规避 Windows 长路径下子进程 cwd 启动失败。",
    "旧版 Connector 私有档案在启动时通过同盘目录重命名原子迁移；支持重命名完成但元数据尚未写入时自动恢复，源目录与目标目录冲突时保留两份数据并停止覆盖。",
    "Connector 启动和内部工作区切换不再写用户级 CODEX_HOME，也不再广播 WM_SETTINGCHANGE；管理接口启动桌面时按单次进程显式传入所选目录。",
    "Windows 使用 Appx 清单声明的全信任可执行入口启动隔离桌面配置，不再通过 Explorer 继承用户级环境；Codex 子进程会剥离 Connector 私有环境变量。",
    "旧版本留下的全局 CODEX_HOME 仅在管理界面明确操作且所有权可证明时恢复，初始化完成后不再自动打开桌面应用。",
    "旧版本遗留失败升级后转为需要重新验证，安装中断转为可恢复状态；连接器不再无条件重写未变化的历史状态。",
    "初始化、启动和状态读取等可恢复错误统一提供上下文重试入口；未授权工作区只重新检查，不触发无效重装。",
    "新增 codexTurnCompleted、codexThreadClosed、codexThreadArchived 和 codexThreadDeleted 稳定领域事件；保留 codexNotification 原始协议事件用于诊断。",
    "完成事件按 threadId 与 turnId 生成稳定幂等标识，暂时性投递失败自动重试，Bridge Agent 接收后进入持久化 outbox。",
    "macOS 不再等待 6 秒后创建并打开 ~/Documents/Codex/default，个人 Codex 使用与桌面图标相同的标准启动语义。",
    "macOS 与 Windows 统一以真实桌面进程作为启动结果，不再用窗口可见性、前台状态或窗口句柄推断成功。"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "port": {
        "type": "integer",
        "default": 18110,
        "minimum": 1024,
        "maximum": 65535
      },
      "listen": {
        "type": "string",
        "default": "stdio://"
      },
      "projectsDirectory": {
        "type": "string",
        "description": "Absolute directory used for canonical platform project checkouts."
      }
    },
    "additionalProperties": false
  },
  "remoteCapabilities": [
    {
      "name": "codex.project.read",
      "risk": "medium",
      "description": "Read local Codex project roots from Codex desktop state, trusted project config, and thread cwd metadata."
    },
    {
      "name": "codex.thread.read",
      "risk": "medium",
      "description": "Read, list, and search local Codex thread metadata and streamed output."
    },
    {
      "name": "codex.thread.read-state.write",
      "risk": "medium",
      "description": "Mark one local Codex thread read or unread for Connector session management."
    },
    {
      "name": "codex.app.read",
      "risk": "medium",
      "description": "List Codex app-server apps/connectors visible to the local Codex account."
    },
    {
      "name": "codex.turn.write",
      "risk": "medium",
      "description": "Send prompts and steering instructions to local Codex."
    },
    {
      "name": "codex.raw.request",
      "risk": "high",
      "description": "Forward an advanced JSON-RPC request to local Codex app-server."
    },
    {
      "name": "codex.turn.interrupt",
      "risk": "medium",
      "description": "Interrupt an active Codex turn."
    }
  ],
  "transport": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18110"
  },
  "methods": [
    {
      "name": "status",
      "description": "Return connector and Codex app-server connection status.",
      "path": "/invoke/status",
      "httpMethod": "POST",
      "timeoutSecs": 5,
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "listThreads",
      "description": "List local Codex threads with project metadata, runtime/turn status, unread state, and pagination.",
      "path": "/invoke/listThreads",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "modelProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "vscode",
                "exec",
                "appServer",
                "subAgent",
                "subAgentReview",
                "subAgentCompact",
                "subAgentThreadSpawn",
                "subAgentOther",
                "unknown"
              ]
            }
          },
          "archived": {
            "type": "boolean"
          },
          "cwd": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "useStateDbOnly": {
            "type": "boolean"
          },
          "searchTerm": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listProjects",
      "description": "List local Codex projects from Codex desktop state, trusted project config, and thread cwd metadata.",
      "path": "/invoke/listProjects",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "searchTerm": {
            "type": "string"
          },
          "existsOnly": {
            "type": "boolean"
          },
          "includeSaved": {
            "type": "boolean"
          },
          "includeTrusted": {
            "type": "boolean"
          },
          "includeThreadStats": {
            "type": "boolean"
          },
          "threadCursor": {
            "type": "string"
          },
          "threadPageLimit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "maxThreadPages": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "archived": {
            "type": "boolean"
          },
          "useStateDbOnly": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listSessions",
      "description": "List local Codex sessions with project metadata, runtime/turn status, unread state, and pagination.",
      "path": "/invoke/listSessions",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "modelProviders": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "vscode",
                "exec",
                "appServer",
                "subAgent",
                "subAgentReview",
                "subAgentCompact",
                "subAgentThreadSpawn",
                "subAgentOther",
                "unknown"
              ]
            }
          },
          "archived": {
            "type": "boolean"
          },
          "cwd": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "useStateDbOnly": {
            "type": "boolean"
          },
          "searchTerm": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "searchThreads",
      "description": "Search local Codex threads by text and return matching thread metadata.",
      "path": "/invoke/searchThreads",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "searchTerm"
        ],
        "properties": {
          "searchTerm": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "sourceKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "cli",
                "vscode",
                "exec",
                "appServer",
                "subAgent",
                "subAgentReview",
                "subAgentCompact",
                "subAgentThreadSpawn",
                "subAgentOther",
                "unknown"
              ]
            }
          },
          "archived": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "readThread",
      "description": "Read one local Codex thread by id, optionally including turns and items.",
      "path": "/invoke/readThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "includeTurns": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "setThreadReadState",
      "description": "Mark one local Codex thread read or unread and persist the observed thread revision.",
      "path": "/invoke/setThreadReadState",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId",
          "hasUnreadTurn"
        ],
        "properties": {
          "threadId": {
            "type": "string",
            "minLength": 1
          },
          "hasUnreadTurn": {
            "type": "boolean"
          },
          "observedUpdatedAt": {
            "type": [
              "number",
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listThreadTurns",
      "description": "List one page of Codex thread turns with optional full item history.",
      "path": "/invoke/listThreadTurns",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "itemsView": {
            "type": "string",
            "enum": [
              "notLoaded",
              "summary",
              "full"
            ]
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listApps",
      "description": "List Codex app-server apps/connectors visible to the local Codex account.",
      "path": "/invoke/listApps",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "threadId": {
            "type": "string"
          },
          "forceRefetch": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "startThread",
      "description": "Start a new Codex thread through local Codex app-server.",
      "path": "/invoke/startThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "resumeThread",
      "description": "Resume an existing Codex thread.",
      "path": "/invoke/resumeThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "excludeTurns": {
            "type": "boolean"
          },
          "initialTurnsPage": {
            "type": "object",
            "properties": {
              "limit": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              },
              "sortDirection": {
                "type": "string",
                "enum": [
                  "asc",
                  "desc"
                ]
              },
              "itemsView": {
                "type": "string",
                "enum": [
                  "notLoaded",
                  "summary",
                  "full"
                ]
              }
            },
            "additionalProperties": false
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "startTurn",
      "description": "Start a Codex turn in a thread.",
      "path": "/invoke/startTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId",
          "input"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "input": {},
          "model": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "steerTurn",
      "description": "Append steering input to an active Codex turn.",
      "path": "/invoke/steerTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "input"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "input": {},
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "interruptTurn",
      "description": "Interrupt an active Codex turn.",
      "path": "/invoke/interruptTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "recentEvents",
      "description": "Read recent Codex app-server notifications cached by the connector.",
      "path": "/invoke/recentEvents",
      "httpMethod": "POST",
      "timeoutSecs": 5,
      "input_schema": {
        "type": "object",
        "properties": {
          "afterSequence": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "request",
      "description": "Forward a raw JSON-RPC request to local Codex app-server.",
      "path": "/invoke/request",
      "httpMethod": "POST",
      "timeoutSecs": 60,
      "input_schema": {
        "type": "object",
        "required": [
          "method"
        ],
        "properties": {
          "method": {
            "type": "string"
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          }
        },
        "additionalProperties": false
      }
    }
  ],
  "events": [
    {
      "name": "codexNotification",
      "description": "Notification emitted by local Codex app-server.",
      "enabled": true,
      "payload_schema": {
        "type": "object",
        "additionalProperties": true
      }
