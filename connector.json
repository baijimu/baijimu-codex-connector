      "path": "/invoke/setThreadReadState",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId",
          "hasUnreadTurn"
        ],
        "properties": {
          "threadId": {
