{
  "schemaVersion": "3.0.0",
  "appId": "codex-connector",
  "name": "Codex 桌面连接器",
  "version": "4.0.1",
  "description": "通过桌面 IPC 控制用户已有任务；桌面进程退出时明确不可用。",
  "icon": {
    "mediaType": "image/png",
    "data": ""
  },
  "publisher": {
    "name": "Baijimu",
    "homepage": "https://baijimu.com"
  },
  "source": {
    "type": "github",
    "repo": "baijimu/baijimu-codex-connector",
    "revision": "v4.0.1"
  },
  "runtime": {
    "type": "process",
    "command": "baijimu-connector-codex",
    "args": [
      "start"
    ],
    "stopArgs": [
      "stop"
    ],
    "processOwnership": "host",
    "healthCheck": {
      "type": "http",
      "url": "http://127.0.0.1:18111/healthz",
      "timeoutSecs": 2,
      "expectStatus": 200
    }
  },
  "management": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18111",
    "auth": {
      "type": "connector_token"
    },
    "operations": {
      "setupState": {
        "method": "GET",
        "path": "/management/v1/setup/state"
      },
      "ensureCodexReady": {
        "method": "POST",
        "path": "/management/v1/setup/ensure-ready"
      },
      "checkoutPlatformProject": {
        "method": "POST",
        "path": "/management/v1/projects/checkout"
      }
    }
  },
  "hostRequirements": {
    "minimumVersion": "0.6.0",
    "capabilities": [
      "connector.process.host-managed.v1",
      "connector.managed-tool-dependencies.v1",
      "connector.presentation.icon.v1"
    ]
  },
  "managedToolDependencies": [
    {
      "id": "baijimu-cli",
      "minimumVersion": "0.1.50",
      "requiredFor": [
        "install",
        "start"
      ],
      "executablePathEnv": "CODEX_CONNECTOR_BAIJIMU_BINARY"
    }
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "port": {
        "type": "integer",
        "default": 18111,
        "minimum": 1024,
        "maximum": 65535
      },
      "projectsDirectory": {
        "type": "string",
        "description": "用于标准平台项目检出的绝对目录。"
      }
    },
    "additionalProperties": false
  },
  "remoteCapabilities": [
    {
      "name": "codex.project.read",
      "risk": "medium",
      "description": "从设备系统默认 Codex 状态、项目配置和任务元数据中读取项目根目录。"
    },
    {
      "name": "codex.thread.read",
      "risk": "medium",
      "description": "读取、列出和搜索本地 Codex 任务元数据及流式输出。"
    },
    {
      "name": "codex.turn.write",
      "risk": "medium",
      "description": "向本地 Codex 发送提示词和引导指令。"
    },
    {
      "name": "codex.turn.interrupt",
      "risk": "medium",
      "description": "中断正在执行的 Codex 轮次。"
    },
    {
      "name": "codex.project.write",
      "risk": "high",
      "description": "在指定设备目录新建本地项目，或通过平台 CLI 检出当前授权工作区项目。"
    }
  ],
  "transport": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:18111"
  },
  "methods": [
    {
      "name": "status",
      "description": "返回桌面 IPC 连接状态及能力。",
      "path": "/invoke/status",
      "httpMethod": "POST",
      "timeoutSecs": 5,
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      }
    },
    {
      "name": "listThreads",
      "description": "读取桌面只读元数据索引；运行状态及内容须通过 readThread 的 IPC 快照读取。",
      "path": "/invoke/listThreads",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "archived": {
            "type": "boolean"
          },
          "cwd": {
            "type": "string"
          },
          "searchTerm": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listProjects",
      "description": "分页读取桌面只读索引中的项目目录，支持路径筛选和归档状态筛选。",
      "path": "/invoke/listProjects",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500
          },
          "searchTerm": {
            "type": "string"
          },
          "existsOnly": {
            "type": "boolean"
          },
          "archived": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listSessions",
      "description": "读取桌面只读元数据索引；运行状态及内容须通过 readThread 的 IPC 快照读取。",
      "path": "/invoke/listSessions",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "archived": {
            "type": "boolean"
          },
          "cwd": {
            "type": "string"
          },
          "searchTerm": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "searchThreads",
      "description": "读取桌面只读元数据索引；运行状态及内容须通过 readThread 的 IPC 快照读取。",
      "path": "/invoke/searchThreads",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "searchTerm"
        ],
        "properties": {
          "searchTerm": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sortKey": {
            "type": "string",
            "enum": [
              "created_at",
              "updated_at"
            ]
          },
          "sortDirection": {
            "type": "string",
            "enum": [
              "asc",
              "desc"
            ]
          },
          "archived": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "readThread",
      "description": "按 ID 读取一个本地 Codex 任务，可选择包含轮次和条目。",
      "path": "/invoke/readThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "includeTurns": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "listThreadTurns",
      "description": "从桌面 IPC 完整历史快照分页读取轮次。",
      "path": "/invoke/listThreadTurns",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "resumeThread",
      "description": "连接桌面任务所有者并读取快照；不创建独立运行时或争用任务写入权。",
      "path": "/invoke/resumeThread",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "excludeTurns": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "startTurn",
      "description": "在任务中启动一个 Codex 轮次。",
      "path": "/invoke/startTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId",
          "input"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "input": {},
          "model": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "steerTurn",
      "description": "通过桌面 IPC 引导当前轮次；不支持按 turnId 条件提交。",
      "path": "/invoke/steerTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "required": [
          "threadId",
          "input"
        ],
        "properties": {
          "threadId": {
            "type": "string"
          },
          "input": {}
        },
        "additionalProperties": false
      }
    },
    {
      "name": "interruptTurn",
      "description": "中断正在执行的 Codex 轮次。",
      "path": "/invoke/interruptTurn",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "threadId",
          "turnId"
        ]
      }
    },
    {
      "name": "recentEvents",
      "description": "读取桌面 IPC 原始修订事件；缺口或断线后重新读取任务。",
      "path": "/invoke/recentEvents",
      "httpMethod": "POST",
      "timeoutSecs": 5,
      "input_schema": {
        "type": "object",
        "properties": {
          "afterSequence": {
            "type": "integer",
            "minimum": 0
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 500,
            "default": 100
          }
        },
        "additionalProperties": false
      }
    },
    {
      "name": "prepareProject",
      "description": "验证已有本地目录、新建本地项目目录，或检出当前授权工作区项目；返回设备上的实际目录。",
      "path": "/invoke/prepareProject",
      "httpMethod": "POST",
      "timeoutSecs": 120,
      "input_schema": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "LOCAL_DIRECTORY"
              },
              "directory": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "directory"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "NEW_LOCAL_DIRECTORY"
              },
              "parent": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "parent",
              "name"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "const": "WORKSPACE_PROJECT"
              },
              "projectId": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "type",
              "projectId"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "pendingRequests",
      "description": "读取指定 Codex 线程当前等待用户处理的请求。",
      "path": "/invoke/pendingRequests",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          }
        },
        "required": [
          "threadId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "respondToRequest",
      "description": "按线程、轮次和请求 ID 核对当前待处理请求，再向同一桌面所有者提交单次响应。",
      "path": "/invoke/respondToRequest",
      "httpMethod": "POST",
      "timeoutSecs": 30,
      "input_schema": {
        "type": "object",
        "properties": {
          "threadId": {
            "type": "string"
          },
          "turnId": {
            "type": "string"
          },
          "requestId": {
            "type": [
              "integer",
              "string"
            ]
          },
          "result": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "decision": {
                    "enum": [
                      "accept",
                      "decline",
                      "cancel"
                    ]
                  }
                },
                "required": [
                  "decision"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "answers": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "object",
                      "properties": {
                        "answers": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "answers"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "answers"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "threadId",
          "turnId",
          "requestId",
          "result"
        ],
        "additionalProperties": false
      }
    }
  ],
  "events": [
    {
      "name": "codexDesktopEvent",
      "description": "桌面 IPC 的原始修订事件；断线、streamId 变化或 sequence/revision 缺口后须重新 readThread。",
      "enabled": true,
      "payload_schema": {
        "type": "object",
        "required": [
          "sequence",
          "receivedAt",
          "message",
          "streamId"
        ],
        "properties": {
          "sequence": {
            "type": "integer"
          },
          "receivedAt": {
            "type": "string"
          },
          "message": {
            "type": "object"
          },
          "streamId": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  ]
}
