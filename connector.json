                  "desc"
                ]
              },
              "itemsView": {
                "type": "string",
                "enum": [
                  "notLoaded",
                  "summary",
                  "full"
                ]
              }
            },
            "additionalProperties": false
          },
          "params": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      }
